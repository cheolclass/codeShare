using UnityEngine;

public class ObstacleSpawner : MonoBehaviour
{
	[SerializeField]
	private GameController gameController;

	[SerializeField]
	private GameObject obstaclePrefab;

	[SerializeField]
	private float currentSpawnTime = 2f;        // 장애물 생성 주기

	[SerializeField]
	private float minX = -2f, maxX = 2f;        // 오브젝트 스폰 X 좌표 범위

	[SerializeField]
	private float minY = -5f, maxY = 5.25f;     // 오브젝트 이동 타겟 Y, 스폰 시작 Y 좌표

	private MemoryPool memoryPool;

	private float lastSpawnTime = 0f;

	private void Awake()
	{
		memoryPool = new MemoryPool(obstaclePrefab);
	}

	private void Update()
	{
		// 게임이 시작되지 않았거나 이미 게임오버 상태라면 스폰 루틴 스킵
		if (gameController.IsGameStart == false || gameController.IsGameOver == true) return;

		if (Time.time - lastSpawnTime > currentSpawnTime)
		{
			lastSpawnTime = Time.time;
			SpawnObject();
		}
	}

	private void SpawnObject()
	{
		Vector3 start = new Vector3(Random.Range(minX, maxX), maxY, 0f);
		Vector3 end = new Vector3(Random.Range(minX, maxX), minY, 0f);

		// 메모리 풀로부터 비활성 오브젝트 하나를 수거 및 좌표 설정 후 활성화
    ///GameObject clone = Instantiate(obstaclePrefab, start, Quaternion.identity);
		GameObject clone = memoryPool.ActivatePoolItem(start);

		// 통합된 ObstacleController 컴포넌트를 가져옴 
    ///if (clone.TryGetComponent<Obstacle2>(out var obstacle))  ///  
		if (clone.TryGetComponent<ObstacleController>(out var obstacle))
		{
			obstacle.Setup(this, start, end);
		}
		else
		{
			Debug.LogError($"장애물 프리팹에 ObstacleController 컴포넌트 없음! 대상: {obstaclePrefab.name}");
			Destroy(clone);
		}
	}

	// 풀 아이템을 수거할 때 점수를 올려줄지(회피성공), 안 올릴지(총알사살) 분기 판정
	public void DeactivateObject(GameObject clone, bool isEvaded)
	{
    	///gameController.Score++;	// 플레이어가 회피한 장애물이 사라질 때 점수 +1  ///
		///memoryPool.DeactivatePoolItem(clone);		

   		// 정상적으로 살아서 바닥까지 피해 내려갔을 때만 스코어 상승
		if (isEvaded)
		{
			gameController.Score++;
		}

		// 메모리 풀 내부 리스트에 회수 조치
		memoryPool.DeactivatePoolItem(clone);
	}
}
